# MongoDB connection string (required)
MONGO_URI=mongodb://localhost:27017

# MongoDB database name (optional, default: acg_protocol)
MONGO_DB=acg_protocol

# Embedding model cache directory (optional)
EMBEDDING_CACHE_DIR=

# Corpus cache directory (optional, default: ~/.cache/acg-mcp).
# Searches run over an in-memory copy of the indexed chunks that is synced
# incrementally from MongoDB and saved here, so a restart does not have to
# download every embedding again. Set to an empty value to disable the file.
ACG_CACHE_DIR=
